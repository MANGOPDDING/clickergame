{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "小さな町の年代記 軽量版",
  "mainBinaryName": "LittleTownChroniclesLite",
  "version": "0.36.0",
  "identifier": "jp.littletown.chronicles.lite",
  "build": {
    "beforeBuildCommand": "node desktop/stage-lightweight.cjs",
    "frontendDist": "../dist/tauri-web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "小さな町の年代記 軽量版",
        "width": 1280,
        "height": 900,
        "minWidth": 420,
        "minHeight": 460,
        "useHttpsScheme": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: https://ipc.localhost; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Japanese",
          "English"
        ]
      }
    }
  },
  "plugins": {
    "gameContent": {
      "endpoint": "https://raw.githubusercontent.com/MANGOPDDING/clickergame/game-updates/latest.json",
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE2Q0FDMjJCNjhCM0RGMzQKUldRMDM3Tm9LOExLRnZSeWtRNjgxbmRaMXFWRUo3RCtsOTJrY0JQejlHaW1nbXJla0I4d1RGVzcK"
    },
    "updater": {
      "endpoints": [
        "https://github.com/MANGOPDDING/clickergame/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENGOTU5MzZBNThBRjY2QzYKUldUR1pxOVlhcE9WejZ4czNtM0NZZklqdm8wRVpOaGpIQXdqSThRbi9ic0RNcXRnUkIzb2tGZlQK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
